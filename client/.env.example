# Base URL of the IdeaForge API. Leave as /api in development (Vite proxies it to the server).
# In production set it to your deployed backend, e.g. https://ideaforge-api.onrender.com/api
VITE_API_BASE_URL=/api

# Show the small developer-only "AI: Connected / Demo Mode" indicator in production builds
VITE_SHOW_AI_STATUS=false
