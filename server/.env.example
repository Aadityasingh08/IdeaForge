# Server port
PORT=5000

# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/ideaforge

# AI provider: "llm" for real AI calls, "fallback" for deterministic demo mode
AI_PROVIDER=fallback

# Anthropic API key (server-side only — never exposed to the client)
AI_API_KEY=

# Model used when AI_PROVIDER=llm
AI_MODEL=claude-opus-5

# Optional: reasoning effort (low | medium | high | xhigh | max) and per-call timeout
AI_EFFORT=medium
AI_TIMEOUT_MS=120000

# Allowed browser origin(s) for CORS — comma-separated for multiple
CLIENT_URL=http://localhost:5173

# Dev only: force specific AI tasks to fail to demo Retry / Continue manually
# (e.g. AI_SIMULATE_FAILURE=challenge,visual). Leave empty normally.
AI_SIMULATE_FAILURE=

# Optional rate limits (requests per minute per IP)
API_RATE_LIMIT=300
AI_RATE_LIMIT=30
